<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AdaptedPE.TeacherSignInPage"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="22,25,22,25"
            Spacing="18">

            <Button
                Text="‹  Back"
                FontSize="16"
                TextColor="#1464D2"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                Padding="0"
                Clicked="OnBackClicked" />

            <Label
                Text="Teacher Sign in"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#111111"
                HorizontalTextAlignment="Center"
                Margin="0,12,0,14" />

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Email"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#171717" />
                <Entry
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    TextColor="#171717"
                    PlaceholderColor="#667085"
                    BackgroundColor="#F5F7FA" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Password"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#171717" />
                <Entry
                    Placeholder="Enter your password"
                    IsPassword="True"
                    TextColor="#171717"
                    PlaceholderColor="#667085"
                    BackgroundColor="#F5F7FA" />
            </VerticalStackLayout>

            <Button
                Text="Sign in"
                FontSize="17"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#1464D2"
                CornerRadius="10"
                HeightRequest="52"
                Margin="0,12,0,0"
                Clicked="OnSignInClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
